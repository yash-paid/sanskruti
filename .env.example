# ==============================================================================
# Sanskruti eBooks - PayU India Hosted Checkout Environment Configuration
# ==============================================================================
# Instructions:
# 1. In Netlify Dashboard, navigate to: Site settings > Environment variables
# 2. Add the variables below.
# 3. Default mode is TEST. Never set PAYU_MODE=LIVE until sandbox testing is approved.
# ==============================================================================

# Mode Switch: 'TEST' (Sandbox) or 'LIVE' (Production).
# Defaults safely to 'TEST' if not set or blank.
PAYU_MODE=TEST

# Primary Merchant Key and Salt (Obtained from PayU Merchant Dashboard)
# For TEST sandbox, PayU provides test credentials or standard test sandbox key:
PAYU_KEY=your_payu_merchant_key_here
PAYU_SALT=your_payu_merchant_salt_here

# (Optional) Distinct Test & Production keys:
# If provided, the system automatically uses TEST or LIVE keys based on PAYU_MODE.
PAYU_TEST_KEY=your_payu_test_key_here
PAYU_TEST_SALT=your_payu_test_salt_here

PAYU_LIVE_KEY=your_payu_live_key_here
PAYU_LIVE_SALT=your_payu_live_salt_here

# Public Website URL (Used for PayU callback redirection surl / furl)
# Netlify provides this automatically in Netlify deployments via URL or SITE_URL.
SITE_URL=https://sanskrutiservice.in

# Cryptographic Order Signing Secret (Used to generate tamper-proof eBook delivery tokens)
# Generate a random 32+ character string (e.g., openssl rand -hex 24)
ORDER_SIGNING_SECRET=your_random_secure_signing_secret_here
